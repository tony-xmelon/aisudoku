<?xml version="1.0" encoding="utf-8"?>
<!--
    The nine, cut out of the cell.

    Deliberately wider than the middle square of the grid so it crosses the ruled lines
    rather than grazing them - which is exactly what the app does to a photograph when it
    shows you what it read. Every coordinate sits inside the 21..87 safe zone, so no
    launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The bowl: an outer circle with the counter punched out of it by the even-odd rule. -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M32,43a20,20 0 1,1 40,0a20,20 0 1,1 -40,0z
                          M40.6,43a11.4,11.4 0 1,1 22.8,0a11.4,11.4 0 1,1 -22.8,0z" />

    <!-- The stem, rounded at the foot. Its top is hidden inside the bowl. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M62.6,43L72,43L72,79.3a4.7,4.7 0 0,1 -9.4,0z" />
</vector>
