<?xml version="1.0" encoding="utf-8"?>
<!--
  A three by three block of cells: the smallest thing that still reads as a sudoku at
  launcher size. Three cells are filled to suggest a puzzle part-solved rather than a
  plain grid, which is what the app is actually for.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Filled cells, drawn first so the grid lines sit over them. -->
    <path
        android:fillColor="#7C4DFF"
        android:pathData="M30,30 h16 v16 h-16 z" />
    <path
        android:fillColor="#B388FF"
        android:pathData="M46,46 h16 v16 h-16 z" />
    <path
        android:fillColor="#536DFE"
        android:pathData="M62,62 h16 v16 h-16 z" />

    <!-- The grid: outer border plus two lines each way. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M30,30 h48 v48 h-48 z" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:pathData="M46,30 V78 M62,30 V78 M30,46 H78 M30,62 H78" />
</vector>
