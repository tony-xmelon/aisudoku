<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone, including by being backed up off it.

  android:allowBackup="false" already stops both of these, but it is deprecated from
  Android 12 and the replacement is per-path rather than all-or-nothing - so saying it
  once here keeps the behaviour explicit rather than inherited from a deprecated
  attribute. It matches what docs/privacy-policy.md promises: the puzzles, the
  photographs and the settings are on this phone and nowhere else, and uninstalling takes
  them with it.

  Device transfer is excluded as well as cloud backup. Carrying a puzzle history to a new
  phone would be a kindness, but it is a different promise from the one already made, and
  quietly widening where a user's photographs can travel is not a thing to do as a side
  effect of a lint warning.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
