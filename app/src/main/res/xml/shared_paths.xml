<?xml version="1.0" encoding="utf-8"?>
<!--
  The one folder the app is willing to hand out, and only the one.

  Photographs kept back from a scan live here so they can be sent to somebody who can
  look at them. Everything else the app holds - the puzzle history and its photographs -
  stays private, because nothing needs to share it.
-->
<paths>
    <!-- Photographs of scans that would not read. -->
    <external-files-path name="scans" path="Pictures/" />
    <!-- The same, when there is no external storage to write to. -->
    <files-path name="fallback-scans" path="scans/" />
    <!-- The straightened photograph of each saved puzzle. -->
    <files-path name="history" path="history/" />
</paths>
