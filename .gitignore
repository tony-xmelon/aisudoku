# Full-resolution corpus photographs are large (roughly 20MB each) and do not
# belong in git history. See docs/superpowers/specs for the corpus policy.
corpus/*.jpg
corpus/*.jpeg
corpus/*.png

# Android / Gradle
.gradle/
build/
local.properties
*.apk
*.aab
captures/
.cxx/

# IDE
.idea/
*.iml

# Python (model training)
__pycache__/
*.pyc
.venv/
venv/

# Firebase App Distribution: the service account key is a credential.
# google-services.json is not secret and may be committed when the app module exists.
firebase-service-account*.json
*-service-account.json
.firebase/
